# Clave de OpenAI para el SDK de agentes (requerida para correr los 3 programas)
OPENAI_API_KEY=sk-...

# Opcionales
PARACHUTE_MODEL=gpt-4.1-mini          # modelo usado por todos los agentes
PARACHUTE_WEATHER_MODE=live           # "live" (Open-Meteo real) o "mock" (datos simulados)
PARACHUTE_APPOINTMENTS_FILE=data/citas.json
